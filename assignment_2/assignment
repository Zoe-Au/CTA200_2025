   "outputs": [],
   "source": [
    "from collections.abc import Callable"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "62aa7ea8f3806275",
   "metadata": {},
   "outputs": [],
   "source": [
    "def newton(f: Callable[[float | int], float | int], df: Callable[[float | int], float | int], x0: float, \n",
    "           epsilon=1e-6, max_iter=30) -> float | int | None:\n",
    "    \"\"\"Return and print the root of f found by Newton iteration with initial guess x0, tolerated error \n",
    "    epsilon and maximum number of iterations max_iter. Return None f a root is not found within this \n",
    "    number of iterations, and print \"Iteration failed\". If a ZeroDivisionError is encountered, print \n",
    "    'Iteration failed: Zero division error' and return None.\n",
    "    \"\"\"\n",
    "    try: \n",
    "        cur_iteration = 0\n",
    "        while cur_iteration < max_iter and abs(f(x0)) >= epsilon:\n",
    "            x1 = x0 - f(x0) / df(x0)\n",
    "            x0 = x1\n",
    "            cur_iteration += 1\n",
    "        if abs(f(x0)) < epsilon:\n",
    "            print(f\"Found root in {cur_iteration} iterations\")\n",
    "            return x0\n",
    "        else:\n",
    "            print('Iteration failed')\n",
    "            return None\n",
    "    except ZeroDivisionError:\n",
    "        print('Iteration failed: Zero division error')\n",
    "        return None"
   ]
  },
