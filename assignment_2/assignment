   "source": [
    "def f(x: float | int) -> float | int:\n",
    "    \"\"\" Return x^3 - x^2 - 1.\n",
    "\n",
    "    The type of the return corresponds to the type of the input.\n",
    "    Fail silently if the input type is wrong.\n",
    "    \"\"\"\n",
    "    if isinstance(x, int) or isinstance(x, float):\n",
    "        return x ** 3 - x ** 2 - 1\n",
    "\n",
    "\n",
    "def df(x: float | int) -> float | int:\n",
    "    \"\"\" Return 3*x^2 - 2x.\n",
    "\n",
    "    The type of the return corresponds to the type of the input.\n",
    "    Fail silently if the input type is wrong.\n",
    "    \"\"\"\n",
    "    if isinstance(x, int) or isinstance(x, float):\n",
    "        return 3 * x ** 2 - 2 * x"
   ]
  },
